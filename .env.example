# ============================================================
# AI Blog Writer: environment variables
# Copy to .env and fill in what you use. Never commit .env.
# ============================================================

# Model provider and name (MODEL_NAME selects the provider):
#   Local Ollama:  ollama/qwen2.5:7b                           (no API key)
#   OpenRouter:    openrouter/meta-llama/llama-3.1-8b-instruct:free   (needs OPENROUTER_API_KEY)
#   Gemini:        a Gemini model name from Google's docs      (needs GOOGLE_API_KEY)
# If MODEL_NAME is not set, ollama/qwen2.5:7b is used.
MODEL_NAME=ollama/qwen2.5:7b

# API keys (only for the provider you chose)
GOOGLE_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API key: https://app.tavily.com
# Without it the router always chooses generation (no web retrieval).
TAVILY_API_KEY=your_tavily_api_key_here

# Set to false to disable web retrieval even when a Tavily key is present
ENABLE_SEARCH=true

# Max words per blog section
SECTION_WORD_BUDGET=300

# Max parallel section writers (CLI only; keep at 3 for free tiers)
MAX_CONCURRENCY=3

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=ai-blog-writer
